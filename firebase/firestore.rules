rules_version = '2';

// Only the owner's account (Josh's) can read or write, and only the documents
// the app uses: the board and the XP bank (users/{uid}/kanban/{board|xp}) and
// History days (users/{uid}/history/{day}). Anyone else, signed in or not,
// gets nothing, so a stranger can't use up the free quota either.
// The uid isn't a secret. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && userId == 'JP323rFescUBlrZfwIls8EOk78o1';
    }

    // A board write must carry, as its base, the rev of the board it
    // replaces, so a device that hasn't seen the cloud's current board can't
    // overwrite it (see js/sync.js). A board from before revs goes through.
    match /users/{userId}/kanban/board {
      allow read, create, delete: if isOwner(userId);
      allow update: if isOwner(userId)
                    && 'rev' in request.resource.data
                    && (! ('rev' in resource.data)
                        || request.resource.data.get('base', null) == resource.data.rev);
    }

    match /users/{userId}/kanban/xp {
      allow read, write: if isOwner(userId);
    }

    // A History day is only ever created, never replaced: a device that
    // hasn't seen the day another device filed can't overwrite it (see
    // js/sync.js). To file it again, delete it first.
    match /users/{userId}/history/{day} {
      allow read, create, delete: if isOwner(userId);
    }

    // Temporary: the phone-bug debug log, one document per page load (see
    // js/debuglog.js). Remove with that file once the bug is fixed.
    match /users/{userId}/debug/{load} {
      allow read, write: if isOwner(userId);
    }
  }
}
