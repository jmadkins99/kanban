rules_version = '2';

// Only the owner's account (Josh's) can read or write, and only the documents
// the app uses: the board and the XP bank (users/{uid}/kanban/{board|xp}) and
// History days (users/{uid}/history/{day}). Anyone else, signed in or not,
// gets nothing, so a stranger can't use up the free quota either.
// The uid isn't a secret. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && userId == 'JP323rFescUBlrZfwIls8EOk78o1';
    }

    match /users/{userId}/kanban/{doc} {
      allow read, write: if isOwner(userId) && doc in ['board', 'xp'];
    }

    match /users/{userId}/history/{day} {
      allow read, write: if isOwner(userId);
    }
  }
}
